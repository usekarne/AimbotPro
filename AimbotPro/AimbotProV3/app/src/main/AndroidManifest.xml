<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network (optional telemetry / model updates) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service for screen capture + overlay.
         NOTE: FOREGROUND_SERVICE_SPECIAL_USE was declared in v3 but never
         requested by the service code (which only requests
         FOREGROUND_SERVICE_TYPE_MEDIA_PROJECTION). Dropped in v4 to keep
         the manifest honest about what the app actually does. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Overlay / drawing on top of other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Storage (legacy) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Accessibility service for input simulation.
         BIND_ACCESSIBILITY_SERVICE is a system-only permission enforced on
         the <service> declaration below — cannot be granted via <uses-permission>. -->

    <!-- Keep device awake -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Hardware features (optional) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.AimbotPro"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:theme="@style/Theme.AimbotPro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service: MediaProjection capture + YOLO inference + overlay.
             foregroundServiceType declares the mediaProjection subtype only —
             we never request specialUse in code, so the v3 manifest declaration
             was dead and has been removed. -->
        <service
            android:name=".service.CoreAimbotService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="com.webstrike.aimbotpro.action.START" />
                <action android:name="com.webstrike.aimbotpro.action.STOP" />
                <action android:name="com.webstrike.aimbotpro.action.TOGGLE_FEATURE" />
            </intent-filter>
        </service>

        <!-- Accessibility service: input injection -->
        <service
            android:name=".service.AimbotAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
