<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="28dp">

            <ImageView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:src="@drawable/ic_launcher_foreground"
                android:contentDescription="@string/app_name"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_main"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/brand_primary"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtitle_main"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_version"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Status card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_mod_item"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_idle"
                android:textSize="16sp"
                android:textColor="@color/brand_warning"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/fpsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FPS: -- | Latency: -- ms"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Permissions card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_mod_item"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERMISSIONS"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnOverlay"
                style="@style/Widget.ModButton"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="@string/btn_grant_overlay"/>

            <Button
                android:id="@+id/btnAccessibility"
                style="@style/Widget.ModButton"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="@string/btn_grant_accessibility"/>

            <Button
                android:id="@+id/btnNotifications"
                style="@style/Widget.ModButton"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="@string/btn_grant_notifications"/>
        </LinearLayout>

        <!-- Action buttons -->
        <Button
            android:id="@+id/btnStart"
            style="@style/Widget.ModButton.Primary"
            android:layout_width="match_parent"
            android:text="@string/btn_start"/>

        <Button
            android:id="@+id/btnStop"
            style="@style/Widget.ModButton.Danger"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:enabled="false"
            android:text="@string/btn_stop"/>

        <!-- Disclaimer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/footer_disclaimer"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:layout_marginTop="24dp"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>
